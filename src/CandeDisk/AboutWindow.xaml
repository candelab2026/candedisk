<Window x:Class="CandeDisk.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CandeDisk"
        Title="{l:T AboutTitle, Plain=True}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico">
    <StackPanel Margin="24" Width="420">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="Assets/logo.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="CandeDisk" FontSize="26" FontWeight="SemiBold" Foreground="#14233C" />
                <TextBlock x:Name="VersionText" Foreground="#555" />
                <TextBlock Text="{l:T AboutTagline}" Foreground="#555" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="{l:T AboutDescription}" />

        <TextBlock TextWrapping="Wrap" Background="#FFF4CE" Padding="10,8" Margin="0,0,0,12">
            <Run FontWeight="SemiBold" Text="{l:T AboutWarningLabel}" />
            <Run Text="{l:T AboutWarning}" />
        </TextBlock>

        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
            <Run Text="{l:T AboutLicense}" />
        </TextBlock>
        <TextBlock Margin="0,0,0,16">
            <Hyperlink NavigateUri="https://github.com/candelab2026/candedisk" RequestNavigate="Link_RequestNavigate">
                github.com/candelab2026/candedisk
            </Hyperlink>
        </TextBlock>

        <Button Content="{l:T AboutClose}" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                MinWidth="90" Padding="8,3" />
    </StackPanel>
</Window>
