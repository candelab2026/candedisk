<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CandeDisk</RootNamespace>
    <AssemblyName>CandeDisk</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <Version>1.1.0</Version>
    <Product>CandeDisk</Product>
    <Authors>CandeLab</Authors>
    <Description>Disk and partition manager for Windows</Description>
    <Copyright>Copyright (c) 2026 CandeLab</Copyright>
  </PropertyGroup>

  <!-- In Release l'exe chiede l'elevazione UAC; in Debug parte in sola lettura. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CandeDisk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <!-- Una guida per lingua (docs/guide/xx.md): la stessa letta su GitHub e mostrata nell'app.
         Il nome logico è guide.xx.md; i file non portano "guide." nel nome perché MSBuild
         scambierebbe "guide.de.md" per una risorsa localizzata e la metterebbe in un assembly satellite. -->
    <EmbeddedResource Include="..\..\docs\guide\*.md" LogicalName="guide.%(Filename)%(Extension)" />
    <!-- Traduzioni dell'interfaccia: aggiungere una lingua = aggiungere un file .lang. -->
    <EmbeddedResource Include="Languages\*.lang" LogicalName="lang.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
