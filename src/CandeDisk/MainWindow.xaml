<Window x:Class="CandeDisk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CandeDisk - Gestione dischi" Width="1120" Height="720" MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
        <Style x:Key="ToolText" TargetType="TextBlock">
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Background="White">
        <Menu DockPanel.Dock="Top" Padding="2,2">
            <MenuItem Header="_File">
                <MenuItem x:Name="MenuRefresh" Header="_Aggiorna" InputGestureText="F5" Click="Refresh_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconRefresh}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MenuElevate" Header="Riavvia come a_mministratore" Click="Elevate_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconShield}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copia _riepilogo dei dischi" Click="CopySummary_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconCopy}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Esci" InputGestureText="Alt+F4" Click="Exit_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconExit}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Disco">
                <MenuItem x:Name="MenuInit" Header="_Inizializza (GPT)" Click="Init_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconInit}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Partizione">
                <MenuItem x:Name="MenuCreate" Header="_Crea partizione..." InputGestureText="Ctrl+N" Click="Create_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconCreate}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MenuFormat" Header="_Formatta..." InputGestureText="Ctrl+Maiusc+F" Click="Format_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconFormat}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MenuResize" Header="_Ridimensiona..." InputGestureText="Ctrl+R" Click="Resize_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconResize}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="MenuDelete" Header="_Elimina..." InputGestureText="Canc" Click="Delete_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconDelete}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Aiuto">
                <MenuItem Header="_Guida" InputGestureText="F1" Click="Help_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconHelp}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Apri cartella dei _log" Click="OpenLogs_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconLog}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Sito del progetto su _GitHub" Click="Website_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconWeb}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Informazioni su CandeDisk" Click="About_Click">
                    <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconInfo}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border x:Name="AdminBanner" DockPanel.Dock="Top" Background="#FFF4CE" Padding="12,6" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="ElevateButton" DockPanel.Dock="Right" Padding="10,3" Margin="12,0,0,0" Click="Elevate_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconShield}" Width="16" Height="16" />
                        <TextBlock Style="{StaticResource ToolText}" Text="Riavvia come amministratore" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Modalità sola lettura: per formattare, creare, eliminare o ridimensionare servono i privilegi di amministratore." />
            </DockPanel>
        </Border>

        <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
            <Button Style="{StaticResource ToolButton}" x:Name="RefreshButton" Click="Refresh_Click" ToolTip="Rilegge dischi e partizioni (F5)">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconRefresh}" />
                    <TextBlock Style="{StaticResource ToolText}" Text="Aggiorna" />
                </StackPanel>
            </Button>
            <Separator />
            <Button Style="{StaticResource ToolButton}" x:Name="InitButton" Click="Init_Click" ToolTip="Prepara un disco nuovo con tabella GPT">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconInit}" />
                    <TextBlock Style="{StaticResource ToolText}" Text="Inizializza" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" x:Name="CreateButton" Click="Create_Click" ToolTip="Crea una partizione nello spazio non allocato (Ctrl+N)">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconCreate}" />
                    <TextBlock Style="{StaticResource ToolText}" Text="Crea" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" x:Name="FormatButton" Click="Format_Click" ToolTip="Formatta la partizione selezionata (Ctrl+Maiusc+F)">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconFormat}" />
                    <TextBlock Style="{StaticResource ToolText}" Text="Formatta" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" x:Name="ResizeButton" Click="Resize_Click" ToolTip="Riduce o estende la partizione selezionata (Ctrl+R)">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconResize}" />
                    <TextBlock Style="{StaticResource ToolText}" Text="Ridimensiona" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" x:Name="DeleteButton" Click="Delete_Click" ToolTip="Elimina la partizione selezionata (Canc)">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconDelete}" />
                    <TextBlock Style="{StaticResource ToolText}" Text="Elimina" />
                </StackPanel>
            </Button>
            <Separator />
            <Button Style="{StaticResource ToolButton}" Click="Help_Click" ToolTip="Apre la guida (F1)">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconHelp}" />
                    <TextBlock Style="{StaticResource ToolText}" Text="Guida" />
                </StackPanel>
            </Button>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Pronto" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ModeText" Foreground="#555" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="DiskList" Grid.Column="0" Margin="0,0,10,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="DiskList_SelectionChanged" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,5">
                            <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource IconDisk}"
                                  Width="26" Height="26" Margin="0,0,10,0" Stroke="#1F6FD1" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="#555" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="DiskHeader" Grid.Row="0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                <Grid x:Name="BarGrid" Grid.Row="1" Height="72" Margin="0,0,0,6" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="12" Height="12" Background="#1F6FD1" Margin="0,0,5,0" />
                    <TextBlock Text="Windows" Margin="0,0,14,0" Foreground="#555" />
                    <Border Width="12" Height="12" Background="#C98A10" Margin="0,0,5,0" />
                    <TextBlock Text="Speciale (EFI, ripristino)" Margin="0,0,14,0" Foreground="#555" />
                    <Border Width="12" Height="12" Background="#4F9D6B" Margin="0,0,5,0" />
                    <TextBlock Text="Dati" Margin="0,0,14,0" Foreground="#555" />
                    <Border Width="12" Height="12" Background="#E4E4E4" Margin="0,0,5,0" />
                    <TextBlock Text="Non allocato" Foreground="#555" />
                </StackPanel>

                <DataGrid x:Name="PartitionGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          SelectionChanged="PartitionGrid_SelectionChanged">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Crea partizione..." Click="Create_Click">
                                <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconCreate}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Formatta..." Click="Format_Click">
                                <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconFormat}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Ridimensiona..." Click="Resize_Click">
                                <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconResize}" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Elimina..." Click="Delete_Click">
                                <MenuItem.Icon><Path Style="{StaticResource Icon}" Data="{StaticResource IconDelete}" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                        <DataGridTextColumn Header="Unità" Binding="{Binding Letter}" Width="55" />
                        <DataGridTextColumn Header="Etichetta" Binding="{Binding Label}" Width="*" />
                        <DataGridTextColumn Header="File system" Binding="{Binding FileSystem}" Width="85" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TypeText}" Width="120" />
                        <DataGridTextColumn Header="Dimensione" Binding="{Binding SizeText}" Width="95" />
                        <DataGridTextColumn Header="Libero" Binding="{Binding FreeText}" Width="95" />
                        <DataGridTextColumn Header="Stato" Binding="{Binding FlagsText}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
