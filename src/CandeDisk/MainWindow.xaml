<Window x:Class="CandeDisk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CandeDisk - Gestione dischi" Width="1120" Height="700" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <DockPanel>
        <Border x:Name="AdminBanner" DockPanel.Dock="Top" Background="#FFF4CE" Padding="12,6" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="ElevateButton" DockPanel.Dock="Right" Content="Riavvia come amministratore"
                        Padding="10,2" Margin="12,0,0,0" Click="Elevate_Click" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Modalità sola lettura: per formattare, creare, eliminare o ridimensionare servono i privilegi di amministratore." />
            </DockPanel>
        </Border>

        <ToolBar DockPanel.Dock="Top">
            <Button x:Name="RefreshButton" Content="Aggiorna" Click="Refresh_Click" Padding="8,3" />
            <Separator />
            <Button x:Name="InitButton" Content="Inizializza (GPT)" Click="Init_Click" Padding="8,3" />
            <Button x:Name="CreateButton" Content="Crea partizione..." Click="Create_Click" Padding="8,3" />
            <Button x:Name="FormatButton" Content="Formatta..." Click="Format_Click" Padding="8,3" />
            <Button x:Name="ResizeButton" Content="Ridimensiona..." Click="Resize_Click" Padding="8,3" />
            <Button x:Name="DeleteButton" Content="Elimina..." Click="Delete_Click" Padding="8,3" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Pronto" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="DiskList" Grid.Column="0" Margin="0,0,10,0"
                     SelectionChanged="DiskList_SelectionChanged" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="#555" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="DiskHeader" Grid.Row="0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                <Grid x:Name="BarGrid" Grid.Row="1" Height="72" Margin="0,0,0,10" />

                <DataGrid x:Name="PartitionGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          SelectionChanged="PartitionGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                        <DataGridTextColumn Header="Unità" Binding="{Binding Letter}" Width="55" />
                        <DataGridTextColumn Header="Etichetta" Binding="{Binding Label}" Width="*" />
                        <DataGridTextColumn Header="File system" Binding="{Binding FileSystem}" Width="85" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TypeText}" Width="120" />
                        <DataGridTextColumn Header="Dimensione" Binding="{Binding SizeText}" Width="95" />
                        <DataGridTextColumn Header="Libero" Binding="{Binding FreeText}" Width="95" />
                        <DataGridTextColumn Header="Stato" Binding="{Binding FlagsText}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
