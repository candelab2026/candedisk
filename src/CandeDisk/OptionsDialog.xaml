<Window x:Class="CandeDisk.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CandeDisk"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel x:Name="SizePanel" Margin="0,0,0,10">
            <TextBlock x:Name="SizeLabel" Margin="0,0,0,2" />
            <TextBox x:Name="SizeBox" />
        </StackPanel>

        <StackPanel x:Name="FsPanel" Margin="0,0,0,10">
            <TextBlock Text="{l:T DlgFileSystem}" Margin="0,0,0,2" />
            <ComboBox x:Name="FsBox" />
        </StackPanel>

        <CheckBox x:Name="QuickBox" Content="{l:T DlgQuick}" IsChecked="True" Margin="0,0,0,10" />

        <StackPanel x:Name="LabelPanel" Margin="0,0,0,10">
            <TextBlock Text="{l:T DlgLabel}" Margin="0,0,0,2" />
            <TextBox x:Name="LabelBox" MaxLength="32" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="OkButton" Content="{l:T DlgOk}" IsDefault="True" MinWidth="80" Padding="8,3"
                    Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="{l:T DlgCancel}" IsCancel="True" MinWidth="80" Padding="8,3" />
        </StackPanel>
    </StackPanel>
</Window>
